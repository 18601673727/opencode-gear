#!/usr/bin/env bash
# oc - OpenCode Gear entry point.
#
# OpenCode Gear is a project-agnostic multi-model orchestration layer for
# OpenCode. `oc` builds the merged OpenCode config for the current project and
# launches `opencode` with it.
#
#   oc --throttle low              interactive session, economical OpenAI Lead
#   oc --throttle high             interactive session, premium OpenAI Lead
#   oc run "fix the failing test"  one-shot run
#   oc status                      throttle, routing and config layers
#   oc routing                     role -> model table
#   oc throttle mid                persist the default throttle level
#
# Throttle selects the OpenAI Lead tier only. Consumer routing (Kimi / DeepSeek
# / GLM) is defined in config/routing.json and never depends on throttle.
set -euo pipefail

VERSION="0.1.0"

fail() { printf 'oc: %s\n' "$*" >&2; exit 2; }

# --- locate the gear installation -----------------------------------------
resolve_self_dir() {
  # Follow symlinks so `ln -s .../bin/oc ~/.local/bin/oc` still works.
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P -- "$(dirname -- "$src")" && pwd)"
    src="$(readlink -- "$src")"
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  cd -P -- "$(dirname -- "$src")" && pwd
}

if [ -n "${OC_GEAR_HOME:-}" ]; then
  GEAR_HOME="$(cd -- "$OC_GEAR_HOME" && pwd)" || fail "OC_GEAR_HOME is not a directory: $OC_GEAR_HOME"
else
  SELF_DIR="$(resolve_self_dir)"
  GEAR_HOME="$(cd -- "$SELF_DIR/.." && pwd)"
fi
HELPER="$GEAR_HOME/bin/oc_config.py"
[ -f "$HELPER" ] || fail "cannot find oc_config.py at $HELPER"

PYTHON_BIN="${OC_GEAR_PYTHON:-python3}"
OPENCODE_BIN="${OC_GEAR_OPENCODE_BIN:-opencode}"

usage() {
  cat <<'EOF'
OpenCode Gear - project-agnostic multi-model orchestration for OpenCode

Usage:
  oc [--throttle low|mid|high] [--project DIR] [--dry-run] [command] [args...]

Commands:
  (none)                launch interactive OpenCode with the gear config
  run <args...>         launch `opencode run` with the gear config
  models [args...]      run `opencode models` with the gear config
  status                show throttle, routing and config layers
  routing               show the consumer role -> model table
  throttle [level]      print, or persist, the default throttle level
  validate              validate the merged configuration
  layers                show configuration layers and trace state
  version               print the OpenCode Gear version
  help                  show this help

Options:
  --throttle LEVEL      low | mid | high   (OpenAI Lead tier, this launch only)
  --project DIR         project directory used for project-local overrides
  --dry-run             print the merged OpenCode config instead of launching
  -h, --help            show this help

Environment:
  OC_GEAR_HOME          gear installation directory (defaults to this script's parent)
  OC_GEAR_THROTTLE      default throttle level (overridden by --throttle)
  OC_GEAR_USER_CONFIG   user override file (default ~/.config/opencode-gear/config.json)
  OC_GEAR_PROJECT_CONFIG project override file (default <project>/.opencode-gear.json)
  OC_GEAR_OPENCODE_BIN  opencode binary to run (default `opencode`)
  OC_GEAR_PYTHON        python interpreter (default `python3`)
  OC_GEAR_TRACE         trace file; only read when observability is enabled
EOF
}

# --- global flags ----------------------------------------------------------
THROTTLE=""
PROJECT=""
DRY_RUN=0

while [ $# -gt 0 ]; do
  case "$1" in
    --throttle)
      [ $# -ge 2 ] || fail "--throttle needs a value"
      THROTTLE="$2"; shift 2 ;;
    --throttle=*)  THROTTLE="${1#*=}"; shift ;;
    --project)
      [ $# -ge 2 ] || fail "--project needs a value"
      PROJECT="$2"; shift 2 ;;
    --project=*)   PROJECT="${1#*=}"; shift ;;
    --dry-run)     DRY_RUN=1; shift ;;
    --)            shift; break ;;
    -h|--help)     usage; exit 0 ;;
    -*)            fail "unknown option: $1 (try 'oc help')" ;;
    *)             break ;;
  esac
done

COMMAND="${1:-}"
if [ $# -gt 0 ]; then shift; fi

HELPER_ARGS=()
if [ -n "$THROTTLE" ]; then HELPER_ARGS+=(--throttle "$THROTTLE"); fi
if [ -n "$PROJECT" ]; then
  [ -d "$PROJECT" ] || fail "--project is not a directory: $PROJECT"
  HELPER_ARGS+=(--cwd "$PROJECT")
fi

# HELPER_ARGS may be empty; the `+` form keeps this safe under `set -u` on the
# bash 3.2 that ships with macOS. The subcommand must come before its options.
helper() {
  local sub="$1"; shift
  "$PYTHON_BIN" "$HELPER" "$sub" ${HELPER_ARGS[@]+"${HELPER_ARGS[@]}"} "$@"
}

resolve_workdir() {
  if [ -n "$PROJECT" ]; then printf '%s\n' "$PROJECT"; else printf '%s\n' "$PWD"; fi
}

activate() {
  local content
  unset OPENCODE_CONFIG 2>/dev/null || true
  if ! content="$(helper build)"; then
    fail "could not build the OpenCode Gear config (run 'oc validate')"
  fi
  export OPENCODE_CONFIG_CONTENT="$content"
}

record_launch() {
  # Opt-in, local-only, no prompt or source content. Failures are ignored.
  helper trace --event launch >/dev/null 2>&1 || true
}

case "$COMMAND" in
  help|-h)  usage; exit 0 ;;
  version|--version) printf 'OpenCode Gear %s\n' "$VERSION"; exit 0 ;;
esac

if [ "$DRY_RUN" = "1" ]; then
  activate
  printf '%s\n' "$OPENCODE_CONFIG_CONTENT"
  exit 0
fi

case "$COMMAND" in
  "")
    activate
    record_launch
    cd "$(resolve_workdir)"
    exec "$OPENCODE_BIN"
    ;;
  run)
    activate
    record_launch
    cd "$(resolve_workdir)"
    exec "$OPENCODE_BIN" run "$@"
    ;;
  models)
    activate
    cd "$(resolve_workdir)"
    exec "$OPENCODE_BIN" models "$@"
    ;;
  status)
    helper status
    ;;
  routing|routes|config)
    helper routing
    ;;
  throttle)
    helper throttle "$@"
    ;;
  validate)
    helper validate
    ;;
  layers)
    helper layers
    ;;
  *)
    fail "unknown command: $COMMAND (try 'oc help')"
    ;;
esac
